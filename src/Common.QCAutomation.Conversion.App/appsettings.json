        //"SecretKeySecretManager": "",

        //-For deployment:
        "SecretARN": ""
        //-For testing in sandbox:
        //"SecretARN": "arn:aws:secretsmanager:ca-central-1:278843204345:secret:QcAutoPoC-FSx-AD-Credentials-Jfb041"
        //-For testing in Dev from local:
        //"SecretARN": "arn:aws:secretsmanager:ca-central-1:075574118481:secret:qca-secret-dev-5IVnyS"
