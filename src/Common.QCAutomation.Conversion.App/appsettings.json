    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.DataProtection": "Error"
            //"Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
        }
