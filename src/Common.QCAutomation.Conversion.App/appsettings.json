        //"SecretKeyGlue": "",
        ///* AWS S3 connection */
        //"AccessKeyS3": "",
        //"SecretKeyS3": ""
    },
    "FSxConnect": {
        "DelayMilliseconds": 1000,
        "MaxAttempts": 3
    },
    "Serilog": {
        "LogGroup": "QCA-CWLogs-env",
        "LibraryLogErrors": false,
        "Using": [
            "AWS.Logger.SeriLog"
        ],
        "Region": "ca-central-1",
        "AWSLogLevel": "Information",
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Error",
                "System": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            "WithThreadName",
            "WithClientIp",
            "WithClientAgent"
        ],
        "Properties": {
            "Application": "Common.QCAutomation.Conversion.App"
        }
    },
    "AllowedHosts": "*"

}